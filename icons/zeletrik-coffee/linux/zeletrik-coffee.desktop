# zeletrik-coffee.desktop — copy to ~/.local/share/applications/ (all users:
# /usr/share/applications/) and copy the hicolor/ tree next to your theme
# icons (~/.local/share/icons/ or /usr/share/icons/). Adjust Exec to the
# real command that starts the application.
[Desktop Entry]
Type=Application
Version=1.0
Name=Patrik Zelena
Exec=zeletrik-coffee
Icon=zeletrik-coffee
Terminal=false
Categories=Utility;
